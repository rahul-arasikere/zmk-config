config BOARD_Q1_MAX_KNOB
    select SOC_STM32F401XC
    imply ZMK_STUDIO
    imply ZMK_BOARD_COMPAT
    imply RETAINED_MEM
    imply RETENTION
    imply RETENTION_BOOT_MODE
